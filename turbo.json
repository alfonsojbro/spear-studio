{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_RUNTIME",
        "SENTRY_DSN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SITE_URL",
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_PROJECT_REF",
        "DATABASE_URL",
        "SENTRY_DSN",
        "WORKER_ID",
        "LOG_LEVEL",
        "JOB_POLL_INTERVAL_MS"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": [
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_PROJECT_REF",
        "DATABASE_URL",
        "SENTRY_DSN",
        "WORKER_ID",
        "LOG_LEVEL",
        "JOB_POLL_INTERVAL_MS"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": []
    },
    "test:integration": {
      "cache": false,
      "env": [
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_PROJECT_REF"
      ]
    }
  }
}
