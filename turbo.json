{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".open-next/**", "dist/**"],
      "env": ["NEXT_RUNTIME", "NEXT_PHASE"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DEV_USER_EMAIL"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": []
    }
  }
}
