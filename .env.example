# Spear Studio env reference. Names only. Never commit real values.
#
# The web app runs on Cloudflare Workers. Local values live in
# apps/web/.dev.vars (gitignored); copy apps/web/.dev.vars.example.
# Deployed values are Worker secrets / vars (wrangler secret put <NAME>).
# Nothing secret is ever NEXT_PUBLIC_*.

# --- apps/web/.dev.vars (local only) ---
# Dev identity stub. Only honoured when NODE_ENV=development.
DEV_USER_EMAIL=

# --- Worker vars (P0b: Cloudflare Access) ---
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Worker secrets (P2: media) ---
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_SUBDOMAIN=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_JWK=
CF_STREAM_WEBHOOK_SECRET=
