# Spear Studio env reference. Names only. Never commit real values.
# Copy each block into the file named in its header and fill it yourself.

# ---------------------------------------------------------------------------
# apps/web/.env.local  (browser-safe values only; no secret key, no DATABASE_URL)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... key from Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Base URL used in magic-link redirects. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=
# Optional. Sentry stays off when empty.
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# apps/worker/.env.local  (server only)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# sb_secret_... key. Server only.
SUPABASE_SECRET_KEY=
# Session pooler URL (IPv4, port 5432). Never the transaction pooler (6543).
DATABASE_URL=
SUPABASE_PROJECT_REF=
# Optional
SENTRY_DSN=
WORKER_ID=
LOG_LEVEL=
JOB_POLL_INTERVAL_MS=

# ---------------------------------------------------------------------------
# packages/db/.env.test.local  (integration tests + db:bootstrap; dev project only)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_URL=
# SUPABASE_PROJECT_REF=
# OWNER_EMAIL=
# Comma separated, e.g. spearmedia.com
# STAFF_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# Cloudflare (filled in P2, worker only; none are NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_SUBDOMAIN=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_JWK=
CF_STREAM_WEBHOOK_SECRET=
