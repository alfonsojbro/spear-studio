{
  "name": "@spear/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:local && next dev --port 3000",
    "db:local": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file=../../packages/db/seed-dev.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:local",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@phosphor-icons/react": "^2.1.10",
    "@spear/core": "workspace:*",
    "@spear/db": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
